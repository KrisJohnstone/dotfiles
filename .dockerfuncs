aws() {
    local -a docker_args=(--rm -i)
    if [[ -t 0 && -t 1 ]]; then
        docker_args+=(-t)
    fi

    docker run \
        --mount "type=bind,source=$HOME/.aws,target=/root/.aws" \
        --mount "type=bind,source=$PWD,target=/aws" \
        --workdir /aws \
        ice88/awscli:latest "$@"
}

discord() {
    docker run \
        -e XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        -e WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
        -v "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
        -v /var/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket \
        --shm-size=1g \
        ice88/discord:latest
}

packer() {
    if [[ ! -d "$HOME/.config/packer/plugins" ]]; then
        mkdir -p "$HOME/.config/packer/plugins" || return
    fi

    docker run -i \
        -e AWS_PROFILE \
        -e AWS_REGION \
        --mount "type=bind,source=$HOME/.aws,target=/root/.aws" \
        --mount "type=bind,source=$HOME/.config/packer/plugins,target=/root/.config/packer/plugins" \
        --mount "type=bind,source=$PWD,target=/aws" \
        --workdir /aws \
        ice88/packer:latest "$@"
}
